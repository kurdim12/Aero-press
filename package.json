{
  "name": "aeropress-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AeroPress Lab (Team Edition): log, duel, monitor and coach AeroPress recipes for championship prep.",
  "scripts": {
    "dev": "npm run build && npm run db:migrate && wrangler dev",
    "dev:lan": "npm run build && npm run db:migrate && wrangler dev --ip 0.0.0.0",
    "dev:web": "vite",
    "build": "vite build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p worker --noEmit && tsc -p web --noEmit && tsc -p . --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@tanstack/react-query": "5.103.2",
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wouter": "3.11.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260925.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.140.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
