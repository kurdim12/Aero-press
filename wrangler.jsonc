{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeropress-lab",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },

  // The Vite build of /web lands in /dist and is served as static assets.
  // Only /api/* runs the Worker; everything else is the single-page app.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeropress-lab",
      // Placeholder for local development. Phase 7 replaces it with the
      // production database id from `wrangler d1 create aeropress-lab`.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (never committed): ANTHROPIC_API_KEY
  //   production: npx wrangler secret put ANTHROPIC_API_KEY
  //   local:      put it in .dev.vars (see .dev.vars.example)
}
