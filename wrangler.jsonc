{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys to it).
  "name": "aero-press",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },

  // The Vite build of /web lands in /dist and is served as static assets.
  // Only /api/* runs the Worker; everything else is the single-page app.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeropress-lab",
      // No database_id on purpose: `wrangler deploy` uses the database already bound to the
      // Worker, else the account's database with this name, else creates it. Local dev keeps
      // its own database in .wrangler/.
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (never committed): ANTHROPIC_API_KEY
  //   production: npx wrangler secret put ANTHROPIC_API_KEY
  //   local:      put it in .dev.vars (see .dev.vars.example)
}
